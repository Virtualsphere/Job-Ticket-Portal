# Copy this file to .env and fill in your real values. Never commit .env.

# Server
PORT=3000
JWT_SECRET=change_this_to_a_long_random_string

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=job_ticket_portal

# First admin account — used ONLY by `npm run seed:admin` (a one-time CLI
# script, not a web form). After that, log in as this admin and create every
# other account (engineer, customer, production manager) from the Admin panel.
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# Where uploaded job attachments are stored on disk (created automatically)
UPLOAD_DIR=./uploads

# Gmail SMTP (use a Gmail App Password, NOT your normal password)
# 1. Turn on 2-Step Verification on the Gmail account: https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character app password below (no spaces)
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Name shown as the sender
MAIL_FROM_NAME=Job Ticket Portal

# Base URL of this app (used in email links)
APP_BASE_URL=http://localhost:3000
